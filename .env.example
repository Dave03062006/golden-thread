# Copy this file to .env.local (for your own settings) or .env.production (for the
# finished game), and fill in the values. Both are ignored by git.

# The address of the music host: the R2 bucket's public URL, or your own domain for it.
# Leave it unset while developing: the game then plays the files in media/ directly.
VITE_MEDIA_URL=https://media.example.com

# The name of the R2 bucket that `npm run media:upload` sends the music to.
R2_BUCKET=golden-thread-media
